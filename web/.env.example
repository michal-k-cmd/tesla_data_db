# --- databáze (Vercel Postgres / Neon integrace nastaví POSTGRES_URL sama) ---
DATABASE_URL=postgresql://user:heslo@localhost:5432/tesla_data?sslmode=disable

# --- přihlášení přes účty vinisto platformy (superadmin + app_users) ---
VINISTO_API_BASE_URL=https://www.vinisto.cz
# integrační klíč; bez něj se použije veřejný b2btest1
VINISTO_API_KEY=
# podpis session cookie – openssl rand -hex 32
SESSION_SECRET=
# token pro skripty (hlavička x-admin-token) – volitelné
ADMIN_TOKEN=
# klíče pro čtení /api/compare z jiných aplikací (čárkami) – volitelné
DATA_API_KEYS=

# --- Helios (TESLA LIGHTING, BI connector FWG atlantiso) ---
# base URL bez view, např. https://<server>:<port>/<instance>
HELIOS_API_URL=
# TAJNÉ – hlavička X-API-Key (jen Vercel env, nikdy do repa)
HELIOS_API_KEY=
HELIOS_VIEW=hvw_api_eshop_produkty_basic
# 1 = neověřovat TLS certifikát Helios serveru (jejich skript volá curl -k)
HELIOS_TLS_INSECURE=
# 1 = denní načtení z API přes Vercel Cron (až bude povolená IP)
HELIOS_CRON_ENABLED=
CRON_SECRET=
